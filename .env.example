# Kasa — Phase 2 environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real secrets. NEVER ship server-only values to the browser.
#
# The local DEMO path needs NONE of these — it runs fully offline. These are
# only for the authenticated (Supabase) path.

# ---------------------------------------------------------------------------
# Browser-safe (publishable). These are exposed to the client bundle.
# ---------------------------------------------------------------------------
# Your Supabase project URL, e.g. https://buwnxnhyxtzrkahkdkct.supabase.co
SUPABASE_URL=
# The "anon" (publishable) key. Safe in the browser; subject to RLS.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only. Used by Supabase Edge Functions / tooling ONLY.
# These bypass RLS or can send SMS — they must never reach the browser or git.
# ---------------------------------------------------------------------------
# Service-role key: full DB access, bypasses RLS. Edge functions only.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Verify (phone verification, Task 7). Edge function env only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------------------------------------------------------------------------
# Configured in the Supabase dashboard (Auth > Providers > Google), NOT here.
# Listed for reference only — do not put the secret in this file or the browser.
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=      (set in Supabase Auth provider config)
# GOOGLE_OAUTH_CLIENT_SECRET=  (set in Supabase Auth provider config)
